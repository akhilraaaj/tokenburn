{
  "name": "use-tokenburn",
  "version": "0.4.1",
  "description": "Collect your AI coding usage (Claude Code, Codex, OpenCode, Gemini CLI, Cursor, ...) locally and publish a privacy-controlled /@username profile.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akhilraaaj/tokenburn.git",
    "directory": "packages/collector"
  },
  "homepage": "https://tokenburn.site",
  "bugs": "https://github.com/akhilraaaj/tokenburn/issues",
  "type": "module",
  "bin": {
    "tokenburn": "dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/cli.mjs",
    "prepublishOnly": "node -e \"require('fs').copyFileSync('../../LICENSE', 'LICENSE')\" && npm run build"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
