{
  "name": "tokenburn-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p packages/shared && tsc -p packages/collector && tsc -p apps/api && tsc -p apps/web",
    "dev:api": "npm run dev -w @tokenburn/api",
    "dev:web": "npm run dev -w @tokenburn/web",
    "collector": "node packages/collector/src/cli.ts",
    "build:cli": "npm run build -w tokenburn"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
