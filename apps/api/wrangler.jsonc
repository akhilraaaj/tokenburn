{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	// Cloudflare Pages project: serves apps/web/dist, whose _worker.js (bundled from src/index.ts by
	// `npm run build`) handles the API, sign-in and /@username share previews ("advanced mode").
	"name": "tokenburn",
	"pages_build_output_dir": "../web/dist",
	"compatibility_date": "2026-09-01",
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "tokenburn",
			"database_id": "eee32472-47ea-4404-b396-1466e9a57b7f",
			"migrations_dir": "migrations"
		}
	],
	"vars": {
		"GITHUB_CLIENT_ID": "Ov23liArlRUBSZpfMjnx"
	}
}
