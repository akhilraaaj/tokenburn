{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tokenburn",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // API, sign-in redirects and profile pages (for share-preview tags) go to the Worker first.
    "run_worker_first": ["/api/*", "/login", "/auth/*", "/@*", "/%40*"]
  },
  "d1_databases": [
    // Create with `npx wrangler d1 create tokenburn` and paste the id here before deploying.
    { "binding": "DB", "database_name": "tokenburn", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "vars": { "GITHUB_CLIENT_ID": "" },
  // Free Workers rate limiting (period must be 10 or 60 seconds). namespace_id is any unique integer per account.
  "ratelimits": [
    { "name": "LOGIN_LIMITER", "namespace_id": "4101", "simple": { "limit": 10, "period": 60 } },
    { "name": "INGEST_LIMITER", "namespace_id": "4102", "simple": { "limit": 60, "period": 60 } }
  ],
  // Daily cleanup of expired sign-ins/sessions and old sync history.
  "triggers": { "crons": ["17 3 * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
